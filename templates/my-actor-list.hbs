<div class="my-actor-list-content">
    <table class="pf2e-table">
        <thead class="pf2ecs-table-header">
            <tr>
                <th></th>
                <th>Name</th>
                <th>Traits</th>
                <th>Soundset</th>
                <th>Play</th>
                <th>State</th>
            </tr>
        </thead>
        <tbody>
            {{#each actors}}
            <tr class="pf2ecs-table-row">
                <td class="pf2ecs-clickable-cell" data-action="open_actor_image" data-id={{this.id}}>
                    <img src="{{this.img}}" alt="{{this.name}}" class="pf2ecs-actor-icon"/>
                </td>

                <td class="pf2ecs-actor-name pf2ecs-clickable-cell" data-action="open_character_sheet" data-id={{this.id}}>{{this.name}}</td>

                <td class="pf2ecs-traits-cell">
                    <div class="tags">
                        {{#each this.traits}}
                        <span class="tag tag_secondary">{{this}}</span>
                        {{/each}}
                        {{#unless this.traits.length}}
                        <span class="pf2ecs-details">None</span>
                        {{/unless}}
                    </div>
                </td>
                <td class="pf2ecs-soundSetName pf2ecs-clickable-cell" data-action="open_actor_sound_select" data-id={{this.id}}>
                    {{this.soundSetName}}
                </td>
                <td>
                    <div class="play-buttons-container">
                        <button class="pf2ecs-play-button" data-action="play_attack_sound" data-id={{this.id}}><i class="fa-solid fa-burst"></i></button>
                        <button class="pf2ecs-play-button" data-action="play_hurt_sound" data-id={{this.id}}><i class="fa-solid fa-person-falling-burst"></i></button>
                        <button class="pf2ecs-play-button" data-action="play_death_sound" data-id={{this.id}}><i class="fa-solid fa-skull"></i></button>
                    </div>
                </td>
                <td>
                    {{#if this.isOverriden}}Manual{{else}}Automated{{/if}}
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>